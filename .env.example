# Environment Configuration for Lotus Telegram Bridge
# Copy this file to .env and adjust variables as needed

# Bridge Server
PORT=8080
HOST=0.0.0.0

# Upstream Lotus Bot API Endpoint
LOTUS_API_BASE=https://bot.lotuschat.vn

# Forwarding Target for Inbound Webhooks
# Set this to your actual Telegram Bot backend webhook URL
# e.g., http://bot-backend:8443/telegram or http://host.docker.internal:8443/webhook
TARGET_BOT_WEBHOOK_URL=http://localhost:8443/webhook

# Secret token verification (optional)
# If set, incoming Lotus webhooks must supply this secret in the 'Secret' header
WEBHOOK_SECRET=

# Optional: Comma-separated list of allowed user IDs for private chats (DM Allowlist)
# Leave empty to allow all users
ALLOWED_USERS=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
